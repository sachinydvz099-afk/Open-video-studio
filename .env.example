# Open Video Studio Configuration
# NOTE: Never store private Hugging Face tokens or secret API keys in this file or any .env file!
# Static client builds expose all VITE_* variables directly to the browser.
# For Hugging Face Spaces integration, users can optionally supply a read-only token in browser session memory.

# Base path for deployment (e.g. for GitHub Pages: /Open-video-studio/ or ./ for relative)
VITE_BASE_URL=./

# Default provider: 'demo' | 'huggingface' | 'custom'
VITE_DEFAULT_PROVIDER=demo

# Optional default Hugging Face Gradio Space endpoint (public inference space)
VITE_HF_DEFAULT_SPACE=Wan-AI/Wan2.1-T2V-14B

# Optional self-hosted or ComfyUI inference endpoint URL
VITE_CUSTOM_INFERENCE_URL=http://127.0.0.1:8188
